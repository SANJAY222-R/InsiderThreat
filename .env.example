# =============================================================================
# Insider Threat Detection System — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ---- Application ----
APP_NAME=InsiderThreatDetection
APP_ENV=development
APP_DEBUG=false
APP_VERSION=1.0.0

# ---- Backend ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4

# ---- Database (SQLite for dev) ----
DATABASE_URL=sqlite:///./insider_threat.db

# ---- Neo4j (graph database) ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=insiderthreat

# ---- JWT / Auth ----
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_TO_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Dataset ----
DATASET_RAW_PATH=./r4.2
DATASET_PROCESSED_PATH=./dataset/processed

# ---- Logging ----
LOG_LEVEL=INFO
LOG_DIR=./logs

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
